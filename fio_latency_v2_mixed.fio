; NVMeVirt latency-maintenance mixed fio template.
;
; Intended runner:
;   bash evaluation/fio_fragment_die_latency_mixed.sh
;
; Workload shape:
;   1. init_write_8g writes the whole 8 GiB measurement region.
;   2. prewarm_seq_read reads that whole region once.
;   3. prewarm_dist_read issues distribution-shaped random reads.
;   4. measure_mixed is the only measured phase: randrw over the same
;      initialized 8 GiB region, with the runner injecting read/write mix
;      and random distribution.
;
; Standalone default is approximately read:write = 10:1 with normal reads.
; The runner rewrites filename, random_distribution, rwmixread, sizes, job
; counts, iodepths, logs, and test_phase hooks in a temporary jobfile.

[global]
ioengine=libaio
direct=1
thread=1
group_reporting=1
time_based=0
norandommap=1
randrepeat=0
invalidate=1
bs=4k
iodepth=32
filename=/dev/nvme0n1

[init_write_8g]
description=Init: sequentially write the entire 8 GiB mixed-test region.
rw=write
offset=0
size=8G
io_size=8G
iodepth=32
numjobs=1
stonewall

[prewarm_seq_read]
description=Warmup: sequentially read the full initialized region once.
rw=read
offset=0
size=8G
io_size=8G
iodepth=32
numjobs=1
stonewall

[prewarm_dist_read]
description=Warmup: distribution-shaped random reads over the initialized region.
rw=randread
random_distribution=normal:20
offset=0
size=8G
io_size=16G
iodepth=32
numjobs=2
stonewall

[enter_test_phase]
description=Runner hook: enable FTL test_phase immediately before measurement.
rw=read
offset=0
size=4k
io_size=4k
iodepth=1
numjobs=1
stonewall

[measure_mixed]
description=Measured phase: mixed random reads and overwrites over the initialized region.
rw=randrw
rwmixread=91
random_distribution=normal:20
offset=0
size=8G
io_size=88G
iodepth=32
numjobs=4
write_lat_log=lat_v2_mixed
write_bw_log=lat_v2_mixed
write_iops_log=lat_v2_mixed
log_avg_msec=1000
stonewall
